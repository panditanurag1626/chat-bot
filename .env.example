# Copy this file to .env.local and fill in real values

# SQLite database file (optional — defaults to ./data/chatbotai.db).
# No separate database server needed; the file lives with the project.
SQLITE_PATH=./data/chatbotai.db

# Long random string used to sign the auth (session) JWT cookie
AUTH_SECRET=change-me-to-a-long-random-string

# Super admin bootstrap — created/promoted automatically on first app start.
# This account can create customer accounts, assign subscription plans, set
# expiry and ban/unban. Change the password after first login.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-strong-password

# Public URL of this app (used in the embed snippet shown to customers)
APP_BASE_URL=http://localhost:3000

# HuggingFace token with "Make calls to Inference Providers" enabled.
# Login to https://huggingface.co/settings/tokens → create token → enable the
# "Make calls to Inference Providers" permission, then paste it below.
# NOTE: free/fine-grained tokens may also need Inference Provider credits in
# https://huggingface.co/settings/inference-providers for paid models.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default text model (OpenAI-compatible HF router).
# The model must be available on a provider-backed route for chat completions.
HF_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Inference provider routing.
#   auto/fastest = let HF pick the fastest provider (default)
#   preferred    = follow your provider preference order
#   <provider>   = pin a specific provider (e.g. together, novita, deepinfra)
HF_PROVIDER=auto
